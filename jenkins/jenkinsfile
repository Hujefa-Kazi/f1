pipeline {
    agent { label 'node1' }
    stages {
        stage('pull') {
            steps {
                git branch: 'main', url: 'https://github.com/Hujefa-Kazi/f1.git'
            echo "pull successful"
            }
        }
        stage('build') {
            steps {
                sh '/opt/apache-maven-3.9.16/bin/mvn clean package'
                echo "build successful"
            }
        }
          stage('test') {
            steps {
                withSonarQubeEnv(installationName: 'sonar-server', credentialsId: 'sonar-token') {
                  sh  '/opt/apache-maven-3.9.16/bin/mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=myproject1 -Dsonar.projectName=myproject'
                }
                
                echo "testing successful" 
            }
        }
        stage('Deploy') {
            steps {
                echo "deploy successful"
                sh 'hostname'  
            }
        }
    }
}