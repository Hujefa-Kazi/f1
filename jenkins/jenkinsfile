pipeline {
    agent { label 'node1' }
    stages {
        stage('pull') {
            steps {
            echo "pull successful"
            }
        }
        stage('build') {
            steps {
                sh '/opt/apache-maven-3.9.16/bin/mvn clean package'
                echo "build successful"
            }
        }
          stage('test') {
            steps {
                echo "testing successful"
            }
        }
        stage('Deploy') {
            steps {
                echo "deploy successful"
                sh 'hostname'  
            }
        }
    }
}